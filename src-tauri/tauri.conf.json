{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "我去抢个座",
  "version": "1.0.24",
  "identifier": "com.igolib.ldu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "我去抢个座",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "visible": true,
        "windowEffects": {
          "effects": [
            "mica",
            "blur",
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "rpm",
      "app",
      "dmg"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNUM1OTI0QTY2NTFBN0EKUldSNkdtV21KRmxjWXpCL2xYUzBPdHVtbkZkYzdtR09ZeDNEQTFHK3JXOGY1S0hHR2VZc1c0YmMK",
      "dialog": false,
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/VenenoSix24/igolib-ldu-web@main/public/latest.json",
        "https://hk.gh-proxy.org/https://raw.githubusercontent.com/VenenoSix24/igolib-ldu-web/refs/heads/main/public/latest.json",
        "https://igolib.ivyris.top/latest.json"
      ]
    }
  }
}
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "我去抢个座",
  "version": "1.0.25",
  "identifier": "com.igolib.ldu",
  "appName": "我去抢个座",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "我去抢个座",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica",
            "blur",
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}